{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "published_on": {
      "type": "datetime"
    },
    "excerpt": {
      "type": "text"
    },
    "author": {
      "type": "string"
    },
    "full_content": {
      "type": "richtext"
    },
    "meta_fields": {
      "type": "component",
      "component": "meta.meta-tag",
      "repeatable": false
    }
  }
}
